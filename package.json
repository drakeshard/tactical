{
  "name": "@drakeshard/tactical",
  "version": "0.1.0",
  "private": true,
  "description": "Renderer-neutral deterministic discrete-battlefield mechanisms for Drakeshard games.",
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "check": "pnpm check:format && pnpm check:architecture && pnpm check:package",
    "check:write": "biome check --write .",
    "check:format": "biome check .",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:package": "node scripts/check-package.mjs",
    "check:build": "node scripts/check-build.mjs",
    "check:public-api-readiness": "node scripts/check-public-api-readiness.mjs",
    "typecheck": "pnpm typecheck:src && pnpm typecheck:test",
    "typecheck:src": "tsc --noEmit -p tsconfig.json",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run --passWithNoTests",
    "chess:build": "tsc -p examples/chess/tsconfig.json",
    "chess:preview": "pnpm chess:build && node scripts/preview-chess.mjs",
    "build": "tsc && pnpm chess:build",
    "verify": "pnpm check && pnpm typecheck && pnpm test && pnpm build && pnpm check:build && pnpm check:public-api-readiness && pnpm check:package-consumer && pnpm performance:pressure",
    "performance:pressure": "node scripts/performance-pressure.mjs",
    "check:package-consumer": "node scripts/check-package-consumer.mjs"
  },
  "keywords": [
    "game-development",
    "tactical",
    "battlefield",
    "pathfinding",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drakeshard/tactical.git"
  },
  "bugs": {
    "url": "https://github.com/drakeshard/tactical/issues"
  },
  "homepage": "https://github.com/drakeshard/tactical#readme",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  },
  "license": "Apache-2.0",
  "exports": {
    "./identity": {
      "types": "./dist/core/identity.d.ts",
      "import": "./dist/core/identity.js"
    },
    "./topology": {
      "types": "./dist/space/topology.d.ts",
      "import": "./dist/space/topology.js"
    },
    "./square": {
      "types": "./dist/square/topology.d.ts",
      "import": "./dist/square/topology.js"
    },
    "./square-queries": {
      "types": "./dist/square/queries.d.ts",
      "import": "./dist/square/queries.js"
    },
    "./placement": {
      "types": "./dist/placement/placement.d.ts",
      "import": "./dist/placement/placement.js"
    },
    "./traversal": {
      "types": "./dist/traversal/traversal.d.ts",
      "import": "./dist/traversal/traversal.js"
    },
    "./reachability": {
      "types": "./dist/movement/reachability.d.ts",
      "import": "./dist/movement/reachability.js"
    },
    "./pathfinding": {
      "types": "./dist/movement/pathfinding.d.ts",
      "import": "./dist/movement/pathfinding.js"
    },
    "./elevation": {
      "types": "./dist/elevation/elevation.d.ts",
      "import": "./dist/elevation/elevation.js"
    },
    "./square-visibility": {
      "types": "./dist/visibility/square-los.d.ts",
      "import": "./dist/visibility/square-los.js"
    },
    "./square-cover": {
      "types": "./dist/cover/square-cover.d.ts",
      "import": "./dist/cover/square-cover.js"
    },
    "./displacement": {
      "types": "./dist/displacement/displacement.d.ts",
      "import": "./dist/displacement/displacement.js"
    }
  }
}
